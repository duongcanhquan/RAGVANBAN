{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix client && npm install --prefix server --legacy-peer-deps",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/drive-sync",
      "schedule": "*/15 * * * *"
    }
  ]
}
