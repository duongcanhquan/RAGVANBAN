# =========================
# Server
# =========================
PORT=5000
HOST=0.0.0.0
# Local: Vite. Production (Vercel): URL app, ví dụ https://your-app.vercel.app
# Nhiều origin: cách nhau bằng dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173

# =========================
# Pinecone
# =========================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=van-ban-hanh-chinh
PINECONE_NAMESPACE=
# us-east-1 (tùy index)
PINECONE_ENVIRONMENT=us-east-1

# =========================
# Multi-LLM Keys (cũng cấu hình được tại /quantri/bo-nao)
# =========================
OPENAI_API_KEY=sk-your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# =========================
# Default providers
# openai | deepseek | gemini | openrouter | groq | mistral | together | fireworks | xai | custom
# =========================
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_CHAT_PROVIDER=deepseek
DEFAULT_EXTRACT_PROVIDER=gemini

# Fallback order (comma-separated)
CHAT_FALLBACK_PROVIDERS=deepseek,openai,gemini
EXTRACT_FALLBACK_PROVIDERS=gemini,deepseek,openai
EMBEDDING_FALLBACK_PROVIDERS=openai,gemini

# =========================
# Model names
# =========================
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_CHAT_MODEL=deepseek-chat
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =========================
# Ingestion
# =========================
# Ưu tiên server/data; fallback ../data (root)
DATA_DIR=./data
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
UPSERT_BATCH_SIZE=64
PUBLIC_DOCS_BASE_URL=https://example.com/van-ban
RAG_TOP_K=16
# Có thể chỉnh Top-K / chunk / disclaimer tại /quantri/rag (ghi đè runtime)
UPLOAD_MAX_BYTES=41943040
OCR_LANGS=vie+eng
WEB_FETCH_TIMEOUT_MS=20000
WEB_MAX_CHARS=120000
# Hủy chat nếu embedding / Pinecone / LLM treo (AbortController). Mặc định 120s.
CHAT_REQUEST_TIMEOUT_MS=120000

# =========================
# Supabase
# =========================
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dùng SERVICE_ROLE trên server (bí mật — không đưa vào client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Client (Vite) — chỉ ANON key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Super-admin đầu tiên (/quantri) — chỉ dùng lúc bootstrap khi chưa có cán bộ
SUPER_ADMIN_EMAIL=quan.duong@caodangvietmy.edu.vn
SUPER_ADMIN_PASSWORD=

# =========================
# Cloudflare R2 (file gốc khi upload tay)
# =========================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=van-ban-goc
# Public URL: bật Public Development URL trên bucket, hoặc custom domain
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# =========================
# Google Drive (file có sẵn — dán link, không copy sang R2)
# =========================
# 1) Google Cloud Console → tạo Service Account → tải JSON
# 2) Share thư mục Drive cho email service account (Viewer)
# 3) Local: đường dẫn file JSON. Vercel: dán nguyên nội dung JSON (1 dòng)
GOOGLE_SERVICE_ACCOUNT_JSON=C:/secrets/rag-drive-sa.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
# false = file gốc ở lại Drive (khuyến nghị). Không copy sang R2. true = copy thêm sang Supabase.
DRIVE_MIRROR_TO_SUPABASE=false

# =========================
# n8n webhook (tùy chọn — tự động hóa an toàn)
# =========================
# Header: X-N8N-Secret: <giá trị này>
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string
